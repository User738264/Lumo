// Значение выражения в инструкции отбрасывается, а побочные эффекты остаются.

func main() {
    // Вычисление без вывода.
    1 + 2 * 3;

    // Первое число читается и отбрасывается, второе выводится.
    read_int();
    print_int(read_int());

    // Вызов print_int в скобках — тоже допустимая инструкция.
    (print_int(42));
}
