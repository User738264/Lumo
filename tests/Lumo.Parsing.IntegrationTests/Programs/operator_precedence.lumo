// Приоритет и ассоциативность арифметических операторов.

func main() {
    // Умножение выполняется раньше сложения: 1 + (2 * 3).
    print_int(1 + 2 * 3);

    // Скобки меняют порядок вычисления.
    print_int((1 + 2) * 3);

    // Бинарные операторы левоассоциативны: (10 - 4) - 3 и (100 / 10) / 5.
    print_int(10 - 4 - 3);
    print_int(100 / 10 / 5);

    // Операторы *, / и % имеют одинаковый приоритет: (2 * 7) % 4 и (17 % 5) * 3.
    print_int(2 * 7 % 4);
    print_int(17 % 5 * 3);

    // Унарный минус связывает сильнее бинарных операторов и может повторяться.
    print_int(-2 * -3);
    print_int(--5);
    print_int(1 - -1);
}
