// Граничные значения 64-битного типа int.

func main() {
    // Максимальное значение записывается литералом.
    print_int(9223372036854775807);

    // Минимальное значение литералом не записать, но его можно вычислить.
    print_int(-9223372036854775807 - 1);

    // Остаток от деления минимального значения на -1 равен нулю и не вызывает переполнения.
    print_int((-9223372036854775807 - 1) % -1);

    // Сумма максимального и минимального значений.
    print_int(9223372036854775807 + (-9223372036854775807 - 1));
}
