// Деление нацело с отбрасыванием дробной части; остаток имеет знак делимого.

func main() {
    print_int(7 / 2);
    print_int(-7 / 2);
    print_int(7 / -2);
    print_int(-7 / -2);
    print_int(0 / 5);

    print_int(7 % 2);
    print_int(-7 % 2);
    print_int(7 % -2);
    print_int(-7 % -2);
    print_int(6 % 3);
}
