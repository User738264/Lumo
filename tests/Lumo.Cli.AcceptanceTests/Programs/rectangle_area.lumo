// Площадь прямоугольника по двум противоположным вершинам.
func main() {
    var x1: int = read_int();
    var y1: int = read_int();
    var x2: int = read_int();
    var y2: int = read_int();
    print_int(rectangle_area(x1, y1, x2, y2));
}

func rectangle_area(x1: int, y1: int, x2: int, y2: int) -> int {
    return abs(x2 - x1) * abs(y2 - y1);
}
