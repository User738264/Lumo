// Пример программы на подмножестве Lumo текущей итерации:
// только функция main, целочисленные выражения, read_int и print_int.
// Для входа 5 программа выводит 11, 1, -3, -1 — по одному числу в строке.

func main() {
    print_int(read_int() * 2 + 1);
    print_int((1 + 2) * 3 % 4);
    print_int(-7 / 2);
    print_int(-7 % 2);
}
